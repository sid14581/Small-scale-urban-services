# Copy to `.env.e2e` (gitignored) for local Playwright runs.
# Never commit real passwords, OTP codes, or Twilio secrets.
#
# Target stack: http://localhost:8080 only (docker compose / nginx).
# Demo seed usernames match `python manage.py seed_groups` — set passwords
# from your local seed output / README (do not paste production secrets).

E2E_BASE_URL=http://localhost:8080

E2E_CITIZEN_USER=citizen
E2E_CITIZEN_PASSWORD=

E2E_STAFF_USER=staff
E2E_STAFF_PASSWORD=

E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=

# --- OTP (required for real login; E2E does NOT bypass OTP) ---
#
# Session setup (`auth.setup.js`) and any UI login/register that completes OTP
# go through the real login → SMS OTP screens. `/api/auth/login/` cookie login
# is not used for E2E session storage.
#
# How to provide the code (first match wins per OTP step):
#   1. E2E_OTP=<code>     Optional one-shot. Consumed after one verify so
#                         multi-role setup will prompt/pause for the next roles.
#                         Do not commit real OTPs. Refresh from SMS/logs each run.
#   2. Headed pause       Auth setup runs headed locally. Or set E2E_HEADED=1.
#                         Playwright Inspector opens via page.pause() — type the
#                         OTP in the browser, click Verify (or leave it filled),
#                         then Resume in the Inspector.
#   3. Readline prompt    If not headed and stdin is a TTY, the runner asks:
#                         "[e2e] Enter OTP for <role> login: "
#
# Without Twilio, backend may log the OTP when SMS is not configured
# (docker compose logs). With Twilio Verify, use the SMS you receive.
#
# CI without a TTY must set E2E_OTP (or fail). Prefer interactive local runs.
E2E_OTP=

# Open Chromium headed for all projects (auth setup is already headed locally).
# E2E_HEADED=1

# Optional second citizen for extra cross-user checks (otherwise tests
# create a foreign complaint as admin and assert citizen gets denied).
E2E_CITIZEN2_USER=
E2E_CITIZEN2_PASSWORD=

# Run:
#   cp .env.e2e.example .env.e2e   # fill passwords
#   npm run test:e2e              # auth setup pauses/prompts for OTP per role
#   E2E_HEADED=1 npm run test:e2e # headed for OTP UI specs too
#   E2E_OTP=123456 npm run test:e2e -- --project=setup
#
# If browsers are missing: npx playwright install chromium
# In some environments set:
# PLAYWRIGHT_BROWSERS_PATH=$HOME/Library/Caches/ms-playwright
