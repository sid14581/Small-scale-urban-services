#!/usr/bin/env bash
# Fail commit if local secret scan finds real-looking secrets.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${ROOT}" ]]; then
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
cd "$ROOT"

if [[ ! -f tests/git/scan_secrets.py ]]; then
  echo "pre-commit: tests/git/scan_secrets.py missing" >&2
  exit 1
fi

echo "pre-commit: running secret scan..."
python3 tests/git/scan_secrets.py
